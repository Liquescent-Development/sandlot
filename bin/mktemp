#!/bin/bash
# macOS Sandbox Runtime follows _CS_DARWIN_USER_TEMP_DIR for implicit mktemp
# forms. Force every implicit product to Sandlot's exact session TMPDIR while
# leaving explicit user templates as native mktemp operands.
set -eo pipefail

fail() {
  printf '%s\n' "sandlot mktemp: $1" >&2
  exit 64
}

tmpdir=${TMPDIR-}
[[ -n "$tmpdir" && "$tmpdir" == /* && "$tmpdir" != *$'\n'* && "$tmpdir" != *$'\r'* ]] \
  || fail 'TMPDIR must be an absolute Sandlot session directory'

original=("$@")
rewritten=()
templates=()
prefix=''
prefix_specified=false
directory=''
directory_specified=false
empty_tmpdir=false
expect=''
unknown=''
after_options=false
index=0

while ((index < ${#original[@]})); do
  argument=${original[index]}
  ((index += 1))

  if [[ "$after_options" == true ]]; then
    templates+=("$argument")
    continue
  fi

  if [[ -n "$expect" ]]; then
    value=$argument
    case "$expect" in
      prefix) prefix=$value; prefix_specified=true ;;
      directory) directory=$value; directory_specified=true; rewritten+=(-p "$value") ;;
    esac
    expect=''
    continue
  fi

  case "$argument" in
    --) after_options=true; rewritten+=(--) ;;
    --directory) rewritten+=(-d) ;;
    --quiet) rewritten+=(-q) ;;
    --dry-run) rewritten+=(-u) ;;
    --unsafe) unknown='--unsafe' ;;
    --tmpdir)
      directory=$tmpdir
      directory_specified=true
      rewritten+=(-p "$tmpdir")
      ;;
    --tmpdir=)
      directory=''
      directory_specified=true
      empty_tmpdir=true
      rewritten+=(-p "$tmpdir")
      ;;
    --tmpdir=*)
      directory=${argument#--tmpdir=}
      directory_specified=true
      rewritten+=(-p "$directory")
      ;;
    -?*)
      short=${argument#-}
      short_index=0
      while ((short_index < ${#short})); do
        option=${short:short_index:1}
        ((short_index += 1))
        case "$option" in
          d|q|u) rewritten+=("-$option") ;;
          t|p)
            remainder=${short:short_index}
            if [[ -n "$remainder" ]]; then
              value=$remainder
              short_index=${#short}
            elif ((index < ${#original[@]})); then
              value=${original[index]}
              ((index += 1))
            else
              expect=$([[ "$option" == t ]] && printf prefix || printf directory)
              break
            fi
            if [[ "$option" == t ]]; then
              prefix=$value
              prefix_specified=true
              rewritten+=(-t "$value")
            else
              directory=$value
              directory_specified=true
              rewritten+=(-p "$value")
            fi
            ;;
          *) unknown="-$option" ;;
        esac
      done
      ;;
    *) templates+=("$argument") ;;
  esac
done

[[ -z "$expect" ]] || fail "option -${expect:0:1} requires an argument"

# Without -t every operand is explicit and native behavior is retained exactly.
if [[ "$prefix_specified" == false && ${#templates[@]} -gt 0 ]]; then
  exec /usr/bin/mktemp "${original[@]}"
fi

[[ -z "$unknown" ]] || fail "unsupported option $unknown"
if [[ "$directory_specified" == true && -n "$directory" && "$directory" != "$tmpdir" ]]; then
  fail 'the -p directory must equal the confined TMPDIR for implicit products'
fi
if [[ "$prefix_specified" == true && -n "$prefix" && ! "$prefix" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
  fail 'the -t prefix must contain only letters, digits, dot, underscore, or hyphen'
fi

if [[ "$prefix_specified" == true ]]; then
  # macOS honors -p for the implicit product generated by -t. Preserve -t and
  # every explicit operand while injecting only the already-confined directory.
  if [[ "$directory_specified" == false ]]; then
    rewritten=(-p "$tmpdir" "${rewritten[@]}")
  fi
  exec /usr/bin/mktemp "${rewritten[@]}" "${templates[@]}"
elif [[ "$empty_tmpdir" == true ]]; then
  exec /usr/bin/mktemp "${rewritten[@]}"
elif [[ "$directory_specified" == true ]]; then
  implicit_template='sandlot-mktemp.XXXXXXXX'
else
  implicit_template="$tmpdir/sandlot-mktemp.XXXXXXXX"
fi

exec /usr/bin/mktemp "${rewritten[@]}" "$implicit_template" "${templates[@]}"
